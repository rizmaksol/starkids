rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Parents — own data only
    match /parents/{parentId} {
      allow read: if request.auth != null && request.auth.uid == parentId;
      allow write: if request.auth != null && request.auth.uid == parentId;
    }

    // Kids — parent owns, but anyone can READ for code-based login
    match /kids/{kidId} {
      allow read: if true;  // needed for 6-digit code login (no auth)
      allow create: if request.auth != null && request.resource.data.parentId == request.auth.uid;
      allow update: if request.auth != null && resource.data.parentId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.parentId == request.auth.uid;
    }

    // Tasks — anyone can read/update (kids submit without auth)
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Task photos
    match /taskPhotos/{taskId} {
      allow read, write: if true;
    }

    // Wallets, Goals — no sensitive data
    match /wallets/{kidId}  { allow read, write: if true; }
    match /goals/{goalId}   { allow read, write: if true; }

    // Rewards, Jobs, Values — parent writes, kids read
    match /rewards/{rewardId} { allow read: if true; allow write: if request.auth != null; }
    match /jobs/{jobId}       { allow read: if true; allow write: if request.auth != null; }
    match /values/{valueId}   { allow read: if true; allow write: if request.auth != null; }

    // Praise
    match /praise/{praiseId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Achievements
    match /achievements/{achievementId} { allow read, write: if true; }

    // Block everything else
    match /{document=**} { allow read, write: if false; }
  }
}
