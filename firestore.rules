rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /parents/{parentId} {
      allow read, write: if request.auth != null && request.auth.uid == parentId;
    }

    match /kids/{kidId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.parentId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.parentId == request.auth.uid;
    }

    match /tasks/{taskId} {
      // Anyone can read tasks — kids are not Firebase-authenticated
      allow read: if true;
      // Anyone can create tasks (parent creates normally; default tasks created on kid add)
      allow create: if request.auth != null;
      // Anyone can update tasks — kid submits without auth, parent approves with auth
      allow update: if true;
      allow delete: if request.auth != null;
    }

    match /wallets/{kidId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
